# ============ LLM chat ============
# PROVIDER: openai (dùng cho cả Groq) | ollama (local) | anthropic
PROVIDER=openai
MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=gsk_...                          # key Groq: console.groq.com
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# ============ Storage (docker compose up -d) ============
# Container publish cổng 5433 (né Postgres native hay chiếm 5432 trên máy dev).
REDIS_URL=redis://localhost:6379/0
POSTGRES_DSN=postgresql+asyncpg://ops:ops@localhost:5433/ops_agent

# ============ tuning (có default, đổi khi cần) ============
# DEBUG=true            # lộ traceback ra response — CHỈ dev, đừng bật production
# SESSION_WINDOW=20
# FACT_TOP_K=20
